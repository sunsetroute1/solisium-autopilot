-- Schema version 5 -> 6: character class title plus extracted weapon-pair rows.
ALTER TABLE user_character ADD COLUMN class_name TEXT;
ALTER TABLE user_character ADD COLUMN class_source TEXT;

CREATE TABLE game_class (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  weapon_a TEXT,
  weapon_b TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);
