CREATE TABLE dataset_snapshot (
  id TEXT NOT NULL PRIMARY KEY,
  source TEXT NOT NULL,
  extracted_at TEXT NOT NULL,
  game_build TEXT NOT NULL,
  game_version TEXT NOT NULL,
  schema_version INTEGER NOT NULL,
  source_path TEXT,
  source_hash TEXT,
  decoder_version TEXT,
  active INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE dataset_alias (
  alias TEXT NOT NULL PRIMARY KEY,
  snapshot_id TEXT NOT NULL,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id)
);

CREATE TABLE game_item (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  grade TEXT,
  category TEXT,
  icon_path TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_weapon (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  item_id INTEGER,
  name TEXT,
  weapon_type TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_armor (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  item_id INTEGER,
  name TEXT,
  slot TEXT,
  material TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_accessory (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  item_id INTEGER,
  name TEXT,
  slot TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_trait (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_rune (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  grade TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_rune_synergy (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_skill (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  skill_type TEXT,
  family TEXT,
  weapon_token TEXT,
  family_confidence TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_skill_effect (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  skill_source_row_id TEXT,
  name TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_skill_formula (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  skill_source_row_id TEXT,
  expression TEXT,
  confidence TEXT NOT NULL,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_stat (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

-- Per-item stat values. `raw_value` is the client integer as stored: the client
-- scales stats differently per field (550 attack speed, 4000 block efficiency)
-- and no scale factor has been verified, so nothing here is divided or formatted.
CREATE TABLE game_item_stat (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  stat_key TEXT NOT NULL,
  stat_name TEXT,
  raw_value INTEGER NOT NULL,
  scope TEXT NOT NULL,
  confidence TEXT NOT NULL,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id, stat_key, scope)
);

-- Shared stat curves. 42 enchant curves and 45 item-level curves serve 1,458
-- items, so each curve is stored once and items link to it. `raw_value` is the
-- client's cumulative total at `level`, not a per-level delta.
CREATE TABLE game_stat_curve (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  curve_id TEXT NOT NULL,
  level INTEGER NOT NULL,
  stat_key TEXT NOT NULL,
  stat_name TEXT,
  raw_value INTEGER NOT NULL,
  confidence TEXT NOT NULL,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, curve_id, level, stat_key)
);

-- Which curve an item follows, and how far that item may actually go.
CREATE TABLE game_item_curve (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  curve_kind TEXT NOT NULL,
  curve_source_table TEXT NOT NULL,
  curve_id TEXT NOT NULL,
  max_level INTEGER,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id, curve_kind)
);

CREATE TABLE game_food (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_recipe (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  recipe_kind TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_material (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_dungeon (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_boss (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  subtitle TEXT,
  level INTEGER,
  category TEXT,
  map_id INTEGER,
  location_label TEXT,
  sync_source TEXT,
  synced_at TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_item_drop (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  item_source_table TEXT NOT NULL DEFAULT 'TLItemLooks',
  item_source_row_id TEXT NOT NULL,
  item_name TEXT,
  source_kind TEXT NOT NULL,
  source_id TEXT NOT NULL,
  source_name TEXT NOT NULL,
  source_level INTEGER,
  source_category TEXT,
  map_id INTEGER,
  location_label TEXT,
  probability REAL,
  quantity INTEGER,
  drop_type TEXT,
  drop_condition TEXT,
  confidence TEXT NOT NULL,
  synced_at TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id)
);

CREATE INDEX game_item_drop_item_idx ON game_item_drop(snapshot_id, item_source_row_id);
CREATE INDEX game_item_drop_source_idx ON game_item_drop(snapshot_id, source_id);
CREATE UNIQUE INDEX game_item_drop_unique_idx ON game_item_drop(
  snapshot_id, item_source_row_id, source_kind, source_id, drop_type, drop_condition
);

CREATE TABLE game_progression (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_talking_wall_statement (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  statement_key TEXT NOT NULL,
  statement TEXT NOT NULL,
  answer_true INTEGER NOT NULL,
  category TEXT,
  notes TEXT,
  source_kind TEXT NOT NULL,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, statement_key)
);

CREATE INDEX game_talking_wall_snapshot ON game_talking_wall_statement(snapshot_id);

CREATE TABLE game_class (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  weapon_a TEXT,
  weapon_b TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

-- Item-component combat-power weights from TLItemCombatPower. These are not
-- live character CP and are not a gear-score watermark.
CREATE TABLE game_combat_power (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  category TEXT,
  base_power INTEGER NOT NULL,
  potential_power INTEGER,
  payload TEXT,
  confidence TEXT NOT NULL,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

-- Derived item-id → combat-power-row map. There is no warehouse foreign key.
CREATE TABLE game_item_power (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  item_source_table TEXT NOT NULL,
  item_source_row_id TEXT NOT NULL,
  power_source_row_id TEXT NOT NULL,
  evidence TEXT NOT NULL,
  confidence TEXT NOT NULL,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, item_source_row_id)
);

CREATE TABLE user_character (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  level INTEGER,
  combat_power INTEGER,
  gear_score INTEGER,
  strength INTEGER,
  dexterity INTEGER,
  wisdom INTEGER,
  perception INTEGER,
  fortitude INTEGER,
  class_name TEXT,
  class_source TEXT,
  server TEXT,
  notes TEXT,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL
);

CREATE TABLE user_equipment (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  character_id TEXT NOT NULL,
  slot TEXT NOT NULL,
  source_table TEXT,
  source_row_id TEXT,
  item_level INTEGER,
  name TEXT,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE user_weapon (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  character_id TEXT NOT NULL,
  slot TEXT NOT NULL,
  source_table TEXT,
  source_row_id TEXT,
  item_level INTEGER,
  name TEXT,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE user_traits (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  character_id TEXT NOT NULL,
  source_table TEXT,
  source_row_id TEXT,
  rank INTEGER,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE user_runes (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  character_id TEXT NOT NULL,
  slot TEXT,
  source_table TEXT,
  source_row_id TEXT,
  rune_level INTEGER,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE user_skills (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  character_id TEXT NOT NULL,
  source_table TEXT,
  source_row_id TEXT,
  loadout TEXT,
  name TEXT,
  skill_level INTEGER,
  family TEXT,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE user_weapon_mastery (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  character_id TEXT NOT NULL,
  weapon TEXT NOT NULL,
  level INTEGER,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE user_build_layer (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  character_id TEXT NOT NULL,
  layer TEXT NOT NULL,
  slot TEXT,
  source_table TEXT,
  source_row_id TEXT,
  name TEXT,
  level INTEGER,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE user_inventory (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  character_id TEXT NOT NULL,
  source_table TEXT,
  source_row_id TEXT,
  quantity INTEGER NOT NULL DEFAULT 0,
  name TEXT,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE user_materials (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  character_id TEXT NOT NULL,
  source_table TEXT,
  source_row_id TEXT,
  quantity INTEGER NOT NULL DEFAULT 0,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE user_currency (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  character_id TEXT NOT NULL,
  currency TEXT NOT NULL,
  amount INTEGER NOT NULL DEFAULT 0,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE user_cooking (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  character_id TEXT NOT NULL,
  level INTEGER,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE user_build (
  id TEXT NOT NULL PRIMARY KEY,
  character_id TEXT NOT NULL,
  name TEXT NOT NULL,
  snapshot_id TEXT,
  payload_json TEXT,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE user_goals (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  character_id TEXT NOT NULL,
  goal_type TEXT NOT NULL,
  label TEXT NOT NULL,
  active INTEGER NOT NULL DEFAULT 1,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE user_combat_session (
  id TEXT NOT NULL PRIMARY KEY,
  character_id TEXT,
  started_at TEXT,
  ended_at TEXT,
  source_path TEXT,
  source_hash TEXT,
  log_version TEXT,
  notes TEXT,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE combat_event (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  session_id TEXT NOT NULL,
  timestamp TEXT,
  actor TEXT,
  target TEXT,
  skill_id TEXT,
  skill_name TEXT,
  damage INTEGER,
  damage_type TEXT,
  critical INTEGER,
  heavy INTEGER,
  hit INTEGER,
  miss INTEGER,
  log_type TEXT NOT NULL,
  raw_line TEXT NOT NULL,
  source_hash TEXT,
  FOREIGN KEY(session_id) REFERENCES user_combat_session(id)
);

CREATE INDEX game_item_snapshot ON game_item(snapshot_id);
CREATE INDEX game_rune_snapshot ON game_rune(snapshot_id);
CREATE INDEX game_skill_snapshot ON game_skill(snapshot_id);
CREATE INDEX game_recipe_snapshot ON game_recipe(snapshot_id);
CREATE INDEX combat_event_session ON combat_event(session_id);

insertSnapshot:
INSERT INTO dataset_snapshot(id, source, extracted_at, game_build, game_version, schema_version, source_path, source_hash, decoder_version, active)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

clearActiveSnapshots:
UPDATE dataset_snapshot SET active = 0;

activateSnapshot:
UPDATE dataset_snapshot SET active = 1 WHERE id = ?;

selectSnapshot:
SELECT * FROM dataset_snapshot WHERE id = ?;

selectActiveSnapshot:
SELECT * FROM dataset_snapshot WHERE active = 1 LIMIT 1;

selectAllSnapshots:
SELECT * FROM dataset_snapshot ORDER BY extracted_at DESC;

insertAlias:
INSERT OR REPLACE INTO dataset_alias(alias, snapshot_id) VALUES (?, ?);

selectAlias:
SELECT alias, snapshot_id FROM dataset_alias WHERE alias = ?;

selectAliases:
SELECT alias FROM dataset_alias WHERE snapshot_id = ? ORDER BY alias;

insertGameItem:
INSERT INTO game_item(snapshot_id, source_table, source_row_id, name, grade, category, icon_path)
VALUES (?, ?, ?, ?, ?, ?, ?);

insertGameRune:
INSERT INTO game_rune(snapshot_id, source_table, source_row_id, name, grade)
VALUES (?, ?, ?, ?, ?);

insertGameSkill:
INSERT INTO game_skill(snapshot_id, source_table, source_row_id, name, skill_type, family, weapon_token, family_confidence)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertGameRecipe:
INSERT INTO game_recipe(snapshot_id, source_table, source_row_id, name, recipe_kind)
VALUES (?, ?, ?, ?, ?);

insertGameWeapon:
INSERT INTO game_weapon(snapshot_id, source_table, source_row_id, item_id, name, weapon_type)
VALUES (?, ?, ?, ?, ?, ?);

insertGameArmor:
INSERT INTO game_armor(snapshot_id, source_table, source_row_id, item_id, name, slot, material)
VALUES (?, ?, ?, ?, ?, ?, ?);

insertGameAccessory:
INSERT INTO game_accessory(snapshot_id, source_table, source_row_id, item_id, name, slot)
VALUES (?, ?, ?, ?, ?, ?);

insertGameRuneSynergy:
INSERT INTO game_rune_synergy(snapshot_id, source_table, source_row_id, name)
VALUES (?, ?, ?, ?);

insertGameSkillEffect:
INSERT INTO game_skill_effect(snapshot_id, source_table, source_row_id, skill_source_row_id, name)
VALUES (?, ?, ?, ?, ?);

insertGameStat:
INSERT INTO game_stat(snapshot_id, source_table, source_row_id, name)
VALUES (?, ?, ?, ?);

insertGameTrait:
INSERT INTO game_trait(snapshot_id, source_table, source_row_id, name)
VALUES (?, ?, ?, ?);

insertGameMaterial:
INSERT INTO game_material(snapshot_id, source_table, source_row_id, name)
VALUES (?, ?, ?, ?);

insertGameBoss:
INSERT INTO game_boss(snapshot_id, source_table, source_row_id, name)
VALUES (?, ?, ?, ?);

countMonsters:
SELECT COUNT(*) FROM game_boss WHERE snapshot_id = ?;

insertGameTalkingWallStatement:
INSERT OR IGNORE INTO game_talking_wall_statement(
  snapshot_id, source_table, source_row_id, statement_key, statement, answer_true, category, notes, source_kind
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

replaceGameTalkingWallStatement:
INSERT OR REPLACE INTO game_talking_wall_statement(
  snapshot_id, source_table, source_row_id, statement_key, statement, answer_true, category, notes, source_kind
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

countTalkingWallStatements:
SELECT COUNT(*) FROM game_talking_wall_statement WHERE snapshot_id = ?;

countTalkingWallBySourceKind:
SELECT COUNT(*) FROM game_talking_wall_statement WHERE snapshot_id = ? AND source_kind = ?;

searchTalkingWallStatements:
SELECT source_table, source_row_id, statement, answer_true, category, notes, source_kind
FROM game_talking_wall_statement
WHERE snapshot_id = ?
  AND lower(statement) LIKE lower(?)
  AND (? = '' OR category = ?)
ORDER BY category COLLATE NOCASE, statement COLLATE NOCASE
LIMIT ?;

countTalkingWallStatementKey:
SELECT COUNT(*) FROM game_talking_wall_statement WHERE snapshot_id = ? AND statement_key = ?;

selectTalkingWallCategories:
SELECT category, COUNT(*) AS statement_count
FROM game_talking_wall_statement
WHERE snapshot_id = ?
GROUP BY category
ORDER BY statement_count DESC, category COLLATE NOCASE;

selectTalkingWallStatementByKey:
SELECT source_table, source_row_id, statement, answer_true, category, notes, source_kind
FROM game_talking_wall_statement
WHERE snapshot_id = ? AND source_table = ? AND source_row_id = ?;

countSyncedMonsters:
SELECT COUNT(*) FROM game_boss WHERE snapshot_id = ? AND synced_at IS NOT NULL;

countItemDrops:
SELECT COUNT(*) FROM game_item_drop WHERE snapshot_id = ?;

maxDropSyncTime:
SELECT MAX(synced_at) AS last_synced_at FROM game_item_drop WHERE snapshot_id = ?;

clearItemDrops:
DELETE FROM game_item_drop WHERE snapshot_id = ?;

clearExtractedItemDrops:
DELETE FROM game_item_drop WHERE snapshot_id = ? AND confidence = 'extracted';

clearCommunityItemDrops:
DELETE FROM game_item_drop WHERE snapshot_id = ? AND confidence = 'community';

countExtractedItemDrops:
SELECT COUNT(*) FROM game_item_drop WHERE snapshot_id = ? AND confidence = 'extracted';

insertItemDrop:
INSERT OR REPLACE INTO game_item_drop(
  snapshot_id, item_source_table, item_source_row_id, item_name,
  source_kind, source_id, source_name, source_level, source_category,
  map_id, location_label, probability, quantity, drop_type, drop_condition,
  confidence, synced_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateGameBossCache:
UPDATE game_boss
SET name = ?, subtitle = ?, level = ?, category = ?, map_id = ?, location_label = ?,
    sync_source = ?, synced_at = ?
WHERE snapshot_id = ? AND source_table = ? AND source_row_id = ?;

selectMonsters:
SELECT source_table, source_row_id, name, subtitle, level, category, map_id, location_label, synced_at
FROM game_boss
WHERE snapshot_id = ?
ORDER BY name COLLATE NOCASE, source_row_id
LIMIT ?;

searchMonsters:
SELECT source_table, source_row_id, name, subtitle, level, category, map_id, location_label, synced_at
FROM game_boss
WHERE snapshot_id = ?
  AND (
    lower(COALESCE(name, source_row_id)) LIKE lower(?)
    OR lower(source_row_id) LIKE lower(?)
    OR lower(COALESCE(location_label, '')) LIKE lower(?)
    OR lower(COALESCE(category, '')) LIKE lower(?)
  )
ORDER BY name COLLATE NOCASE, source_row_id
LIMIT ?;

selectItemDropSources:
SELECT
  item_source_table, item_source_row_id, item_name,
  source_kind, source_id, source_name, source_level, source_category,
  map_id, location_label, probability, quantity, drop_type, drop_condition, confidence
FROM game_item_drop
WHERE snapshot_id = ? AND item_source_row_id = ?
ORDER BY CASE confidence WHEN 'extracted' THEN 0 ELSE 1 END, probability DESC, source_name COLLATE NOCASE;

selectMonsterDrops:
SELECT
  item_source_table, item_source_row_id, item_name,
  source_kind, source_id, source_name, source_level, source_category,
  map_id, location_label, probability, quantity, drop_type, drop_condition, confidence
FROM game_item_drop
WHERE snapshot_id = ? AND source_id = ?
ORDER BY CASE confidence WHEN 'extracted' THEN 0 ELSE 1 END, probability DESC, item_name COLLATE NOCASE;

searchItemDropSources:
SELECT
  item_source_table, item_source_row_id, item_name,
  source_kind, source_id, source_name, source_level, source_category,
  map_id, location_label, probability, quantity, drop_type, drop_condition, confidence
FROM game_item_drop
WHERE snapshot_id = ?
  AND (
    lower(COALESCE(item_name, item_source_row_id)) LIKE lower(?)
    OR lower(item_source_row_id) LIKE lower(?)
  )
ORDER BY probability DESC
LIMIT ?;

insertGameItemStat:
INSERT OR REPLACE INTO game_item_stat(
  snapshot_id, source_table, source_row_id, stat_key, stat_name, raw_value, scope, confidence
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

countItemStats:
SELECT COUNT(*) FROM game_item_stat WHERE snapshot_id = ?;

countItemsWithStats:
SELECT COUNT(DISTINCT source_row_id) FROM game_item_stat WHERE snapshot_id = ?;

selectItemStats:
SELECT source_table, source_row_id, stat_key, stat_name, raw_value, scope, confidence
FROM game_item_stat
WHERE snapshot_id = ? AND source_row_id = ?
ORDER BY scope, stat_key;

selectAllItemStats:
SELECT source_table, source_row_id, stat_key, stat_name, raw_value, scope, confidence
FROM game_item_stat
WHERE snapshot_id = ?
ORDER BY source_row_id, stat_key;

insertGameStatCurve:
INSERT OR REPLACE INTO game_stat_curve(
  snapshot_id, source_table, curve_id, level, stat_key, stat_name, raw_value, confidence
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertGameItemCurve:
INSERT OR REPLACE INTO game_item_curve(
  snapshot_id, source_table, source_row_id, curve_kind, curve_source_table, curve_id, max_level
) VALUES (?, ?, ?, ?, ?, ?, ?);

countStatCurvePoints:
SELECT COUNT(*) FROM game_stat_curve WHERE snapshot_id = ?;

countItemCurveLinks:
SELECT COUNT(*) FROM game_item_curve WHERE snapshot_id = ?;

selectItemCurves:
SELECT curve_kind, curve_source_table, curve_id, max_level
FROM game_item_curve
WHERE snapshot_id = ? AND source_row_id = ?
ORDER BY curve_kind;

-- Curve points for one item, clipped to that item's own max_level when it has one.
selectItemCurvePoints:
SELECT c.curve_kind, c.curve_id, p.level, p.stat_key, p.stat_name, p.raw_value, p.confidence
FROM game_item_curve c
JOIN game_stat_curve p
  ON p.snapshot_id = c.snapshot_id
  AND p.source_table = c.curve_source_table
  AND p.curve_id = c.curve_id
WHERE c.snapshot_id = ? AND c.source_row_id = ?
  AND (c.max_level IS NULL OR p.level <= c.max_level)
ORDER BY c.curve_kind, p.level, p.stat_key;

insertGameSkillFormula:
INSERT INTO game_skill_formula(snapshot_id, source_table, source_row_id, skill_source_row_id, expression, confidence)
VALUES (?, ?, ?, ?, ?, ?);

