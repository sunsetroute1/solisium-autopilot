ORDER BY source_row_id;

insertCharacter:
INSERT OR REPLACE INTO user_character(id, name, level, combat_power, server, notes, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectCharacter:
SELECT * FROM user_character WHERE id = ?;

selectCharacters:
SELECT * FROM user_character ORDER BY name;

deleteEquipment:
DELETE FROM user_equipment WHERE character_id = ?;

insertEquipment:
INSERT INTO user_equipment(character_id, slot, source_table, source_row_id, item_level)
VALUES (?, ?, ?, ?, ?);

selectEquipment:
SELECT slot, source_table, source_row_id, item_level FROM user_equipment WHERE character_id = ? ORDER BY slot;

deleteWeapons:
DELETE FROM user_weapon WHERE character_id = ?;

insertWeapon:
INSERT INTO user_weapon(character_id, slot, source_table, source_row_id, item_level)
VALUES (?, ?, ?, ?, ?);

selectWeapons:
SELECT slot, source_table, source_row_id, item_level FROM user_weapon WHERE character_id = ? ORDER BY slot;

deleteTraits:
DELETE FROM user_traits WHERE character_id = ?;

insertTrait:
INSERT INTO user_traits(character_id, source_table, source_row_id, rank)
VALUES (?, ?, ?, ?);

selectTraits:
SELECT source_table, source_row_id, rank FROM user_traits WHERE character_id = ?;

deleteCharacterRunes:
DELETE FROM user_runes WHERE character_id = ?;

insertCharacterRune:
INSERT INTO user_runes(character_id, slot, source_table, source_row_id, rune_level)
VALUES (?, ?, ?, ?, ?);

selectCharacterRunes:
SELECT slot, source_table, source_row_id, rune_level FROM user_runes WHERE character_id = ?;

deleteCharacterSkills:
DELETE FROM user_skills WHERE character_id = ?;

insertCharacterSkill:
INSERT INTO user_skills(character_id, source_table, source_row_id, loadout)
VALUES (?, ?, ?, ?);

selectCharacterSkills:
SELECT source_table, source_row_id, loadout FROM user_skills WHERE character_id = ?;

deleteInventory:
DELETE FROM user_inventory WHERE character_id = ?;

insertInventory:
INSERT INTO user_inventory(character_id, source_table, source_row_id, quantity)
VALUES (?, ?, ?, ?);

selectInventory:
SELECT source_table, source_row_id, quantity FROM user_inventory WHERE character_id = ?;

deleteMaterials:
DELETE FROM user_materials WHERE character_id = ?;

insertMaterial:
INSERT INTO user_materials(character_id, source_table, source_row_id, quantity)
VALUES (?, ?, ?, ?);

selectMaterials:
SELECT source_table, source_row_id, quantity FROM user_materials WHERE character_id = ?;

deleteCurrency:
DELETE FROM user_currency WHERE character_id = ?;

insertCurrency:
INSERT INTO user_currency(character_id, currency, amount)
VALUES (?, ?, ?);

selectCurrency:
SELECT currency, amount FROM user_currency WHERE character_id = ?;

deleteCooking:
DELETE FROM user_cooking WHERE character_id = ?;

insertCooking:
INSERT INTO user_cooking(character_id, level)
VALUES (?, ?);

selectCooking:
SELECT level FROM user_cooking WHERE character_id = ? LIMIT 1;

deleteGoals:
DELETE FROM user_goals WHERE character_id = ?;

insertGoal:
INSERT INTO user_goals(character_id, goal_type, label, active)
VALUES (?, ?, ?, ?);

selectGoals:
SELECT goal_type, label, active FROM user_goals WHERE character_id = ?;

deleteBuilds:
DELETE FROM user_build WHERE character_id = ?;

insertBuild:
INSERT OR REPLACE INTO user_build(id, character_id, name, snapshot_id, payload_json)
VALUES (?, ?, ?, ?, ?);

selectBuilds:
SELECT id, name, snapshot_id FROM user_build WHERE character_id = ? ORDER BY name;

selectCombatSession:
SELECT * FROM user_combat_session WHERE id = ?;

selectCombatSessions:
SELECT id, character_id, started_at, ended_at, source_path, log_version
FROM user_combat_session
ORDER BY started_at DESC;

insertCombatSession:
INSERT INTO user_combat_session(id, character_id, started_at, ended_at, source_path, source_hash, log_version, notes)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertCombatEvent:
INSERT INTO combat_event(session_id, timestamp, actor, target, skill_id, skill_name, damage, damage_type, critical, heavy, hit, miss, log_type, raw_line, source_hash)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectCombatEvents:
SELECT timestamp, actor, target, skill_id, skill_name, damage, critical, heavy, log_type
FROM combat_event
WHERE session_id = ?
ORDER BY id;

countCombatEvents:
SELECT COUNT(*) FROM combat_event WHERE session_id = ?;

sumCombatDamage:
SELECT CAST(COALESCE(SUM(damage), 0) AS INTEGER) FROM combat_event WHERE session_id = ?;

selectCombatSkillTotals:
SELECT skill_name, skill_id, CAST(COALESCE(SUM(damage), 0) AS INTEGER) AS damage, COUNT(*) AS hits
FROM combat_event
WHERE session_id = ?
GROUP BY skill_name, skill_id
ORDER BY damage DESC;
