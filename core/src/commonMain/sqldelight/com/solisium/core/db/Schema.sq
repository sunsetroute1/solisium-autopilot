WHERE snapshot_id = ?;

selectDistinctItemStatKeys:
SELECT stat_key, MAX(stat_name) AS stat_name
FROM game_item_stat
WHERE snapshot_id = ?
GROUP BY stat_key
ORDER BY stat_key COLLATE NOCASE;

selectItems:
SELECT source_table, source_row_id, name, grade, category
FROM game_item
WHERE snapshot_id = ?
ORDER BY (name IS NULL OR name = '' OR name = source_row_id), name COLLATE NOCASE;

selectItemIcons:
SELECT source_table, source_row_id, icon_path
FROM game_item
WHERE snapshot_id = ? AND icon_path IS NOT NULL AND trim(icon_path) != '';

selectAllItemGrades:
SELECT source_row_id, grade FROM game_item
WHERE snapshot_id = ? AND grade IS NOT NULL AND trim(grade) != ''
UNION ALL
SELECT source_row_id, grade FROM game_rune
WHERE snapshot_id = ? AND grade IS NOT NULL AND trim(grade) != '';

selectBestItemGrade:
SELECT grade FROM (
  SELECT grade,
    CASE source_table
      WHEN 'TLItemLooks_Equip' THEN 0
      WHEN 'TLItemLooks' THEN 1
      WHEN 'TLItemEquip' THEN 2
      ELSE 3
    END AS sort_key
  FROM game_item
  WHERE snapshot_id = ? AND source_row_id = ? AND grade IS NOT NULL AND trim(grade) != ''
  UNION ALL
  SELECT grade, 4 AS sort_key FROM game_rune
  WHERE snapshot_id = ? AND source_row_id = ? AND grade IS NOT NULL AND trim(grade) != ''
)
ORDER BY sort_key
LIMIT 1;

selectDropBrowseItems:
SELECT source_table, source_row_id, name, grade, category
FROM game_item
WHERE snapshot_id = ?
  AND name IS NOT NULL AND trim(name) != '' AND name != source_row_id
ORDER BY name COLLATE NOCASE
LIMIT ?;

selectItemDropSourcesByName:
SELECT
  item_source_table, item_source_row_id, item_name,
  source_kind, source_id, source_name, source_level, source_category,
  map_id, location_label, probability, quantity, drop_type, drop_condition, confidence
FROM game_item_drop
WHERE snapshot_id = ? AND lower(item_name) = lower(?)
ORDER BY CASE confidence WHEN 'extracted' THEN 0 ELSE 1 END, probability DESC, source_name COLLATE NOCASE;

