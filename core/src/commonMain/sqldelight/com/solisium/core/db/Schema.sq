insertGameItemStat:
INSERT OR REPLACE INTO game_item_stat(
  snapshot_id, source_table, source_row_id, stat_key, stat_name, raw_value, scope, confidence
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

countItemStats:
SELECT COUNT(*) FROM game_item_stat WHERE snapshot_id = ?;

countItemsWithStats:
SELECT COUNT(DISTINCT source_row_id) FROM game_item_stat WHERE snapshot_id = ?;

selectItemStats:
SELECT source_table, source_row_id, stat_key, stat_name, raw_value, scope, confidence
FROM game_item_stat
WHERE snapshot_id = ? AND source_row_id = ?
ORDER BY scope, stat_key;

insertGameStatCurve:
INSERT OR REPLACE INTO game_stat_curve(
  snapshot_id, source_table, curve_id, level, stat_key, stat_name, raw_value, confidence
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertGameItemCurve:
INSERT OR REPLACE INTO game_item_curve(
  snapshot_id, source_table, source_row_id, curve_kind, curve_source_table, curve_id, max_level
) VALUES (?, ?, ?, ?, ?, ?, ?);

countStatCurvePoints:
SELECT COUNT(*) FROM game_stat_curve WHERE snapshot_id = ?;

countItemCurveLinks:
SELECT COUNT(*) FROM game_item_curve WHERE snapshot_id = ?;

selectItemCurves:
SELECT curve_kind, curve_source_table, curve_id, max_level
FROM game_item_curve
WHERE snapshot_id = ? AND source_row_id = ?
ORDER BY curve_kind;

-- Curve points for one item, clipped to that item's own max_level when it has one.
selectItemCurvePoints:
SELECT c.curve_kind, c.curve_id, p.level, p.stat_key, p.stat_name, p.raw_value, p.confidence
FROM game_item_curve c
JOIN game_stat_curve p
  ON p.snapshot_id = c.snapshot_id
  AND p.source_table = c.curve_source_table
  AND p.curve_id = c.curve_id
WHERE c.snapshot_id = ? AND c.source_row_id = ?
  AND (c.max_level IS NULL OR p.level <= c.max_level)
ORDER BY c.curve_kind, p.level, p.stat_key;

insertGameSkillFormula:
INSERT INTO game_skill_formula(snapshot_id, source_table, source_row_id, skill_source_row_id, expression, confidence)
VALUES (?, ?, ?, ?, ?, ?);

