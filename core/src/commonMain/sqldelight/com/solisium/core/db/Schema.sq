CREATE TABLE dataset_snapshot (
  id TEXT NOT NULL PRIMARY KEY,
  source TEXT NOT NULL,
  extracted_at TEXT NOT NULL,
  game_build TEXT NOT NULL,
  game_version TEXT NOT NULL,
  schema_version INTEGER NOT NULL,
  source_path TEXT,
  source_hash TEXT,
  decoder_version TEXT,
  active INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE dataset_alias (
  alias TEXT NOT NULL PRIMARY KEY,
  snapshot_id TEXT NOT NULL,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id)
);

CREATE TABLE game_item (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  grade TEXT,
  category TEXT,
  icon_path TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_weapon (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  item_id INTEGER,
  name TEXT,
  weapon_type TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_armor (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  item_id INTEGER,
  name TEXT,
  slot TEXT,
  material TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_accessory (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  item_id INTEGER,
  name TEXT,
  slot TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_trait (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_rune (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  grade TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_rune_synergy (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_skill (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  skill_type TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_skill_effect (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  skill_source_row_id TEXT,
  name TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_skill_formula (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  skill_source_row_id TEXT,
  expression TEXT,
  confidence TEXT NOT NULL,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_stat (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

-- Per-item stat values. `raw_value` is the client integer as stored: the client
-- scales stats differently per field (550 attack speed, 4000 block efficiency)
-- and no scale factor has been verified, so nothing here is divided or formatted.
CREATE TABLE game_item_stat (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  stat_key TEXT NOT NULL,
  stat_name TEXT,
  raw_value INTEGER NOT NULL,
  scope TEXT NOT NULL,
  confidence TEXT NOT NULL,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id, stat_key, scope)
);

-- Shared stat curves. 42 enchant curves and 45 item-level curves serve 1,458
-- items, so each curve is stored once and items link to it. `raw_value` is the
-- client's cumulative total at `level`, not a per-level delta.
CREATE TABLE game_stat_curve (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  curve_id TEXT NOT NULL,
  level INTEGER NOT NULL,
  stat_key TEXT NOT NULL,
  stat_name TEXT,
  raw_value INTEGER NOT NULL,
  confidence TEXT NOT NULL,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, curve_id, level, stat_key)
);

-- Which curve an item follows, and how far that item may actually go.
CREATE TABLE game_item_curve (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  curve_kind TEXT NOT NULL,
  curve_source_table TEXT NOT NULL,
  curve_id TEXT NOT NULL,
  max_level INTEGER,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id, curve_kind)
);

CREATE TABLE game_food (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_recipe (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  recipe_kind TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_material (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_dungeon (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_boss (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE game_progression (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  name TEXT,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id)
);

CREATE TABLE user_character (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  level INTEGER,
  combat_power INTEGER,
  server TEXT,
  notes TEXT,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL
);

CREATE TABLE user_equipment (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  character_id TEXT NOT NULL,
  slot TEXT NOT NULL,
  source_table TEXT,
  source_row_id TEXT,
  item_level INTEGER,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE user_weapon (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  character_id TEXT NOT NULL,
  slot TEXT NOT NULL,
  source_table TEXT,
  source_row_id TEXT,
  item_level INTEGER,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE user_traits (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  character_id TEXT NOT NULL,
  source_table TEXT,
  source_row_id TEXT,
  rank INTEGER,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE user_runes (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  character_id TEXT NOT NULL,
  slot TEXT,
  source_table TEXT,
  source_row_id TEXT,
  rune_level INTEGER,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE user_skills (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  character_id TEXT NOT NULL,
  source_table TEXT,
  source_row_id TEXT,
  loadout TEXT,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE user_inventory (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  character_id TEXT NOT NULL,
  source_table TEXT,
  source_row_id TEXT,
  quantity INTEGER NOT NULL DEFAULT 0,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE user_materials (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  character_id TEXT NOT NULL,
  source_table TEXT,
  source_row_id TEXT,
  quantity INTEGER NOT NULL DEFAULT 0,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE user_currency (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  character_id TEXT NOT NULL,
  currency TEXT NOT NULL,
  amount INTEGER NOT NULL DEFAULT 0,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE user_cooking (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  character_id TEXT NOT NULL,
  level INTEGER,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE user_build (
  id TEXT NOT NULL PRIMARY KEY,
  character_id TEXT NOT NULL,
  name TEXT NOT NULL,
  snapshot_id TEXT,
  payload_json TEXT,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE user_goals (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  character_id TEXT NOT NULL,
  goal_type TEXT NOT NULL,
  label TEXT NOT NULL,
  active INTEGER NOT NULL DEFAULT 1,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE user_combat_session (
  id TEXT NOT NULL PRIMARY KEY,
  character_id TEXT,
  started_at TEXT,
  ended_at TEXT,
  source_path TEXT,
  source_hash TEXT,
  log_version TEXT,
  notes TEXT,
  FOREIGN KEY(character_id) REFERENCES user_character(id)
);

CREATE TABLE combat_event (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  session_id TEXT NOT NULL,
  timestamp TEXT,
  actor TEXT,
  target TEXT,
  skill_id TEXT,
  skill_name TEXT,
  damage INTEGER,
  damage_type TEXT,
  critical INTEGER,
  heavy INTEGER,
  hit INTEGER,
  miss INTEGER,
  log_type TEXT NOT NULL,
  raw_line TEXT NOT NULL,
  source_hash TEXT,
  FOREIGN KEY(session_id) REFERENCES user_combat_session(id)
);

CREATE INDEX game_item_snapshot ON game_item(snapshot_id);
CREATE INDEX game_rune_snapshot ON game_rune(snapshot_id);
CREATE INDEX game_skill_snapshot ON game_skill(snapshot_id);
CREATE INDEX game_recipe_snapshot ON game_recipe(snapshot_id);
CREATE INDEX combat_event_session ON combat_event(session_id);

insertSnapshot:
INSERT INTO dataset_snapshot(id, source, extracted_at, game_build, game_version, schema_version, source_path, source_hash, decoder_version, active)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

clearActiveSnapshots:
UPDATE dataset_snapshot SET active = 0;

activateSnapshot:
UPDATE dataset_snapshot SET active = 1 WHERE id = ?;

selectSnapshot:
SELECT * FROM dataset_snapshot WHERE id = ?;

selectActiveSnapshot:
SELECT * FROM dataset_snapshot WHERE active = 1 LIMIT 1;

selectAllSnapshots:
SELECT * FROM dataset_snapshot ORDER BY extracted_at DESC;

insertAlias:
INSERT OR REPLACE INTO dataset_alias(alias, snapshot_id) VALUES (?, ?);

selectAlias:
SELECT alias, snapshot_id FROM dataset_alias WHERE alias = ?;

selectAliases:
SELECT alias FROM dataset_alias WHERE snapshot_id = ? ORDER BY alias;

insertGameItem:
INSERT INTO game_item(snapshot_id, source_table, source_row_id, name, grade, category, icon_path)
VALUES (?, ?, ?, ?, ?, ?, ?);

insertGameRune:
INSERT INTO game_rune(snapshot_id, source_table, source_row_id, name, grade)
VALUES (?, ?, ?, ?, ?);

insertGameSkill:
INSERT INTO game_skill(snapshot_id, source_table, source_row_id, name, skill_type)
VALUES (?, ?, ?, ?, ?);

insertGameRecipe:
