insertCharacter:
INSERT OR REPLACE INTO user_character(id, name, level, combat_power, gear_score, strength, dexterity, wisdom, perception, fortitude, class_name, class_source, server, notes, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectCharacter:
SELECT * FROM user_character WHERE id = ?;

selectCharacters:
SELECT * FROM user_character ORDER BY name;

