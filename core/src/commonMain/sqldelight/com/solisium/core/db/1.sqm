-- Schema version 1 -> 2: per-item stat values from TLItemMainStatInit /
-- TLItemExtraStatInit, joined through TLItemStats (id, seed).
CREATE TABLE game_item_stat (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  snapshot_id TEXT NOT NULL,
  source_table TEXT NOT NULL,
  source_row_id TEXT NOT NULL,
  stat_key TEXT NOT NULL,
  stat_name TEXT,
  raw_value INTEGER NOT NULL,
  scope TEXT NOT NULL,
  confidence TEXT NOT NULL,
  FOREIGN KEY(snapshot_id) REFERENCES dataset_snapshot(id),
  UNIQUE(snapshot_id, source_table, source_row_id, stat_key, scope)
);
